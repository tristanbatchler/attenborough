# Deployment settings: docker-compose.yml and the nginx config (deploy/) read them. Copy this file
# to .env beside docker-compose.yml on the server and fill it in; see deploy/README.md. Never commit
# .env: it holds the database passwords, and the honeypot's own names and address, which the public
# exhibit and this public repository must never show.

# The exhibit's domain (behind Cloudflare) and the decoy's (DNS only, never proxied). Give the decoy
# a domain of its own, unrelated to the exhibit's: names under one parent domain are easy to list
# together. nginx also serves www.<DECOY_DOMAIN> as the decoy.
EXHIBIT_DOMAIN=attenborough.example.org
DECOY_DOMAIN=decoy.example
# The directories holding fullchain.pem and privkey.pem: the exhibit's certificate, and the decoy
# domain's own (e.g. /etc/letsencrypt/live/<name>). The decoy's must be its own certificate, not a
# wildcard shared with other names: its entry in the public Certificate Transparency logs is what
# brings scanners, and it must name nothing else.
EXHIBIT_TLS_CERTIFICATE_DIR=/etc/letsencrypt/live/example.org
DECOY_TLS_CERTIFICATE_DIR=/etc/letsencrypt/live/decoy.example
# Every name and public IP address the honeypot answers on, comma-separated: the decoy's domain and
# the host's public IP, and any past ones (keep them: older records contain them). A name also
# hides its subdomains (www.). The exhibit shows each as [honeypot].
HONEYPOT_ADDRESSES=decoy.example,203.0.113.5

# PostgreSQL on the host (deploy/database.sql creates the database and both roles).
DB_DATABASE=attenborough
# The API's role: reads and writes rows, never changes the schema.
DB_APP_USERNAME=attenborough_app
DB_APP_PASSWORD=
# The schema's owner: applies migrations (`docker compose run --rm migrate`), and nothing else.
DB_OWNER_USERNAME=attenborough_owner
DB_OWNER_PASSWORD=

# The admin login: a Google OAuth client ("Web application") whose authorised redirect URI is
# https://<EXHIBIT_DOMAIN>/auth/google/callback, and the only Google accounts that may log in,
# comma-separated.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAILS=admin@example.org
