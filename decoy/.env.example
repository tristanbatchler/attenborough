# Where the decoy server reaches the API (server-side only; never sent to visitors).
API_BASE_URL=http://127.0.0.1:8000
# The largest request body the server reads (adapter-node's default is 512K). Matches nginx's
# default client_max_body_size and the API's limit for a reported body, so every body nginx lets
# through is recorded whole. A bigger one is recorded as not captured.
BODY_SIZE_LIMIT=1M
