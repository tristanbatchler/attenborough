": {"$ref": "#/components/schemas/LoginAttempt"}}}, "required": true}, "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LoginOutcome"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}}, "components": {"schemas": {"DecoyHit": {"properties": {"method": {"type": "string", "maxLength": 32, "minLength": 1, "title": "Method"}, "path": {"type": "string", "maxLength": 16384, "title": "Path"}, "query": {"anyOf": [{"type": "string", "maxLength": 16384}, {"type": "null"}], "title": "Query"}, "headers": {"additionalProperties": {"type": "string"}, "type": "object", "maxProperties": 2000, "title": "Headers"}, "body": {"anyOf": [{"type": "string", "maxLength": 1048576, "format": "base64", "contentMediaType": "application/octet-stream"}, {"type": "null"}], "title": "Body"}, "status_code": {"type": "integer", "maximum": 599.0, "minimum": 100.0, "title": "Status Code"}}, "type": "object", "required": ["method", "path", "query", "headers", "body", "status_code"], "title": "DecoyHit", "description": "One request the decoy app served: exactly what the visitor sent, and the status it got."}, "DecoyPasswordAttemptEvent": {"properties": {"kind": {"type": "string", "const": "decoy_password_attempt", "title": "Kind"}, "id": {"type": "integer", "title": "Id"}, "occurred_at": {"type": "string", "format": "date-time", "title": "Occurred At"}, "ip_address": {"type": "string", "title": "Ip Address"}, "decoy_slug": {"type": "string", "title": "Decoy Slug"}, "decoy_accepted": {"type": "boolean", "title": "Decoy Accepted"}}, "type": "object", "required": ["kind", "id", "occurred_at", "ip_address", "decoy_slug", "decoy_accepted"], "title": "DecoyPasswordAttemptEvent"}, "DecoyType": {"type": "string", "enum": ["text", "binary", "trap"], "title": "DecoyType"}, "DecoyViewEvent": {"properties": {"kind": {"type": "string", "const": "decoy_view", "title": "Kind"}, "id": {"type": "integer", "title": "Id"}, "occurred_at": {"type": "string", "format": "date-time", "title": "Occurred At"}, "ip_address": {"type": "string", "title": "Ip Address"}, "decoy_slug": {"type": "string", "title": "Decoy Slug"}, "decoy_type": {"$ref": "#/components/schemas/DecoyType"}}, "type": "object", "required": ["kind", "id", "occurred_at", "ip_address", "decoy_slug", "decoy_type"], "title": "DecoyViewEvent"}, "EventPage": {"properties": {"items": {"items": {"oneOf": [{"$ref": "#/components/schemas/HitEvent"}, {"$ref": "#/components/schemas/LoginAttemptEvent"}, {"$ref": "#/components/schemas/DecoyViewEvent"}, {"$ref": "#/components/schemas/DecoyPasswordAttemptEvent"}], "discriminator": {"propertyName": "kind", "mapping": {"decoy_password_attempt": "#/components/schemas/DecoyPasswordAttemptEvent", "decoy_view": "#/components/schemas/DecoyViewEvent", "hit": "#/components/schemas/HitEvent", "login_attempt": "#/components/schemas/LoginAttemptEvent"}}}, "type": "array", "title": "Items"}, "has_next": {"type": "boolean", "title": "Has Next"}}, "type": "object", "required": ["items", "has_next"], "title": "EventPage", "description": "One page of events, newest first."}, "HTTPValidationError": {"properties": {"detail": {"items": {"$ref": "#/components/schemas/ValidationError"}, "type": "array", "title": "Detail"}}, "type": "object", "title": "HTTPValidationError"}, "HitDetail": {"properties": {"kind": {"type": "string", "const": "hit", "title": "Kind"}, "id": {"type": "integer", "title": "Id"}, "occurred_at": {"type": "string", "format": "date-time", "title": "Occurred At"}, "ip_address": {"type": "string", "title": "Ip Address"}, "method": {"type": "string", "title": "Method"}, "path": {"type": "string", "title": "Path"}, "query": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Query"}, "status_code": {"type": "integer", "title": "Status Code"}, "user_agent": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "User Agent"}, "body_size": {"anyOf": [{"type": "integer"}, {"type": "null"}], "title": "Body Size"}, "headers": {"additionalProperties": {"type": "string"}, "type": "object", "title": "Headers"}, "body": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Body"}, "body_truncated": {"type": "boolean", "title": "Body Truncated"}}, "type": "object", "required": ["kind", "id", "occurred_at", "ip_address", "method", "path", "query", "status_code", "user_agent", "body_size", "headers", "body", "body_truncated"], "title": "HitDetail"}, "HitEvent": {"properties": {"kind": {"type": "string", "const": "hit", "title": "Kind"}, "id": {"type": "integer", "title": "Id"}, "occurred_at": {"type": "string", "format": "date-time", "title": "Occurred At"}, "ip_address": {"type": "string", "title": "Ip Address"}, "method": {"type": "string", "title": "Method"}, "path": {"type": "string", "title": "Path"}, "query": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Query"}, "status_code": {"type": "integer", "title": "Status Code"}, "user_agent": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "User Agent"}, "body_size": {"anyOf": [{"type": "integer"}, {"type": "null"}], "title": "Body Size"}, "body_preview": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Body Preview"}, "body_truncated": {"type": "boolean", "title": "Body Truncated"}}, "type": "object", "required": ["kind", "id", "occurred_at", "ip_address", "method", "path", "query", "status_code", "user_agent", "body_size", "body_preview", "body_truncated"], "title": "HitEvent"}, "IpSummary": {"properties": {"requests": {"type": "integer", "title": "Requests"}, "distinct_paths": {"type": "integer", "title": "Distinct Paths"}, "login_attempts": {"type": "integer", "title": "Login Attempts"}, "first_seen_at": {"anyOf": [{"type": "string", "format": "date-time"}, {"type": "null"}], "title": "First Seen At"}, "last_seen_at": {"anyOf": [{"type": "string", "format": "date-time"}, {"type": "null"}], "title": "Last Seen At"}}, "type": "object", "required": ["requests", "distinct_paths", "login_attempts", "first_seen_at", "last_seen_at"], "title": "IpSummary", "description": "What one IP address did, in numbers. The times are null when it sent no requests."}, "LoginAttempt": {"properties": {"path": {"type": "string", "maxLength": 16384, "title": "Path"}, "username": {"type": "string", "maxLength": 1048576, "title": "Username"}, "password": {"type": "string", "maxLength": 1048576, "title": "Password"}}, "type": "object", "required": ["path", "username", "password"], "title": "LoginAttempt", "description": "Credentials a visitor submitted to one of the decoy app's login forms."}, "LoginAttemptEvent": {"properties": {"kind": {"type": "string", "const": "login_attempt", "title": "Kind"}, "id": {"type": "integer", "title": "Id"}, "occurred_at": {"type": "string", "format": "date-time", "title": "Occurred At"}, "ip_address": {"type": "string", "title": "Ip Address"}, "path": {"type": "string", "title": "Path"}, "username": {"type": "string", "title": "Username"}, "password": {"type": "string", "title": "Password"}, "decoy_accepted": {"type": "boolean", "title": "Decoy Accepted"}}, "type": "object", "required": ["kind", "id", "occurred_at", "ip_address", "path", "username", "password", "decoy_accepted"], "title": "LoginAttemptEvent"}, "LoginOutcome": {"properties": {"success": {"type": "boolean", "title": "Success"}}, "type": "object", "required": ["success"], "title": "LoginOutcome", "description": "Whether the decoy should treat the login as successful: decided here, not in the decoy app."}, "ValidationError": {"properties": {"loc": {"items": {"anyOf": [{"type": "string"}, {"type": "integer"}]}, "type": "array", "title": "Location"}, "msg": {"type": "string", "title": "Message"}, "type": {"type": "string", "title": "Error Type"}, "input": {"title": "Input"}, "ctx": {"type": "object", "title": "Context"}}, "type": "object", "required": ["loc", "msg", "type"], "title": "ValidationError"}}}}