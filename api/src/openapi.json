{"openapi": "3.1.0", "info": {"title": "FastAPI", "version": "0.1.0"}, "paths": {"/exhibit/feed": {"get": {"tags": ["exhibit"], "summary": "List Recent Events", "description": "The latest visitor events from every IP address, newest first.", "operationId": "list_recent_events", "parameters": [{"name": "before", "in": "query", "required": false, "schema": {"anyOf": [{"type": "string", "maxLength": 256}, {"type": "null"}], "title": "Before"}}, {"name": "take", "in": "query", "required": false, "schema": {"type": "integer", "maximum": 200, "minimum": 1, "default": 20, "title": "Take"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/EventPage"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/exhibit/ip/{ip_addr}/activity": {"get": {"tags": ["exhibit"], "summary": "Get Ip Events", "description": "Everything one IP address did, newest first.", "operationId": "get_ip_events", "parameters": [{"name": "ip_addr", "in": "path", "required": true, "schema": {"type": "string", "format": "ipvanyaddress", "title": "Ip Addr"}}, {"name": "before", "in": "query", "required": false, "schema": {"anyOf": [{"type": "string", "maxLength": 256}, {"type": "null"}], "title": "Before"}}, {"name": "take", "in": "query", "required": false, "schema": {"type": "integer", "maximum": 200, "minimum": 1, "default": 20, "title": "Take"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/EventPage"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/exhibit/ip/{ip_addr}/summary": {"get": {"tags": ["exhibit"], "summary": "Get Ip Summary", "description": "What one IP address did, in numbers, where it is, and whether it is banned.", "operationId": "get_ip_summary", "parameters": [{"name": "ip_addr", "in": "path", "required": true, "schema": {"type": "string", "format": "ipvanyaddress", "title": "Ip Addr"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/IpSummary"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/exhibit/hits/{hit_id}": {"get": {"tags": ["exhibit"], "summary": "Get Hit", "description": "One request to the honeypot in full: its headers and its whole stored body. 404 for any\nother request, such as the exhibit's own.", "operationId": "get_hit", "parameters": [{"name": "hit_id", "in": "path", "required": true, "schema": {"type": "integer", "maximum": 9223372036854775807, "minimum": 1, "title": "Hit Id"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HitDetail"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/exhibit/installs/{install_id}": {"get": {"tags": ["exhibit"], "summary": "Get Takeover", "description": "One install through the decoy's installer, and every login into the account it created,\nfrom whichever addresses, oldest first.", "operationId": "get_takeover", "parameters": [{"name": "install_id", "in": "path", "required": true, "schema": {"type": "integer", "maximum": 9223372036854775807, "minimum": 1, "title": "Install Id"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Takeover"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/exhibit/patterns": {"get": {"tags": ["exhibit"], "summary": "Get Patterns", "description": "What visitors are after, who they are, when they come, and their tools and wordlists, in\naggregate. Recomputed at most every few minutes (patterns.py).", "operationId": "get_patterns", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Patterns"}}}}}}}, "/ingest/visits": {"post": {"tags": ["ingest"], "summary": "Judge Visit", "description": "Asked before the decoy serves each request: is the visitor banned, and if not, does a\nresponse rule answer instead (rules.respond)? Never cached, so a change to a ban or a rule\napplies to the very next request.", "operationId": "judge_visit", "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/Visit"}}}, "required": true}, "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/VisitVerdict"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/ingest/hits": {"post": {"tags": ["ingest"], "summary": "Report Hit", "description": "Record a request the decoy app served, as a honeypot hit.\n\nWritten after this response, so the decoy app waits only for the round trip, not the database.", "operationId": "report_hit", "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/DecoyHit"}}}, "required": true}, "responses": {"204": {"description": "Successful Response"}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/ingest/logins": {"post": {"tags": ["ingest"], "summary": "Report Login", "description": "Record submitted credentials and decide the outcome the decoy app shows.\n\nThe only accounts are the authors' (author_password) and the ones installs created\n(report_install), so only those open, with their own password. Every other login fails, as a\nreal site does for guessed credentials, canaries included: they were never anyone's password.\nThe attempt is linked to the canary or install it used (CreateCredentialStuffingAttempt).", "operationId": "report_login", "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/LoginAttempt"}}}, "required": true}, "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LoginOutcome"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/ingest/logins/xmlrpc": {"post": {"tags": ["ingest"], "summary": "Report Xmlrpc Logins", "description": "Record every login one XML-RPC request made, and decide each as report_login does, except\nthat, as in WordPress (wp_xmlrpc_server::login, since 4.4), once one fails, the rest of the\nrequest's logins fail without being checked: a multicall can't try many passwords at once.\nEvery one is recorded all the same; they are what the visitor tried.", "operationId": "report_xmlrpc_logins", "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/XmlrpcLogins"}}}, "required": true}, "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/XmlrpcLoginOutcome"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/ingest/installs": {"post": {"tags": ["ingest"], "summary": "Report Install", "description": "Record a WordPress install and decide its account's password (account_password).\nNothing is installed; a later login with the account is linked to this install.", "operationId": "report_install", "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/InstallAttempt"}}}, "required": true}, "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/InstallOutcome"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/ingest/canaries": {"post": {"tags": ["ingest"], "summary": "Issue Canary", "description": "A fresh secret for a leaked file the decoy is serving, recorded against the visitor.", "operationId": "issue_canary", "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/CanaryRequest"}}}, "required": true}, "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Canary"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/auth/google": {"get": {"tags": ["admin"], "summary": "Start Google Login", "description": "Where to send the admin: Google's consent screen, with a fresh state and PKCE challenge.", "operationId": "start_google_login", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/GoogleLogin"}}}}}}}, "/auth/google/callback": {"post": {"tags": ["admin"], "summary": "Finish Google Login", "description": "Finish a login: a session for a verified ADMIN_EMAILS account, a 404 for anything else.\nThe state is used up whatever happens, so the same callback never works twice.", "operationId": "finish_google_login", "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/GoogleCallback"}}}, "required": true}, "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Session"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/auth/me": {"get": {"tags": ["admin"], "summary": "Get Me", "operationId": "get_me", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Me"}}}}}, "security": [{"HTTPBearer": []}]}}, "/auth/logout": {"post": {"tags": ["admin"], "summary": "Log Out", "description": "End this session.", "operationId": "log_out", "responses": {"204": {"description": "Successful Response"}}, "security": [{"HTTPBearer": []}]}}, "/admin/bans": {"get": {"tags": ["admin"], "summary": "List Active Bans", "description": "Every active ban, newest first.", "operationId": "list_active_bans", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"items": {"$ref": "#/components/schemas/BanRecord"}, "type": "array", "title": "Response List Active Bans"}}}}}, "security": [{"HTTPBearer": []}]}}, "/admin/ip/{ip_addr}/bans": {"get": {"tags": ["admin"], "summary": "List Ip Bans", "description": "Every ban an address has had, newest first.", "operationId": "list_ip_bans", "security": [{"HTTPBearer": []}], "parameters": [{"name": "ip_addr", "in": "path", "required": true, "schema": {"type": "string", "format": "ipvanyaddress", "title": "Ip Addr"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/BanRecord"}, "title": "Response List Ip Bans"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}, "post": {"tags": ["admin"], "summary": "Ban Ip", "description": "Ban an address: the decoy refuses it from now on (ingest.py, judge_visit). 409 if it is\nalready banned.", "operationId": "ban_ip", "security": [{"HTTPBearer": []}], "parameters": [{"name": "ip_addr", "in": "path", "required": true, "schema": {"type": "string", "format": "ipvanyaddress", "title": "Ip Addr"}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/NewBan"}}}}, "responses": {"204": {"description": "Successful Response"}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/admin/bans/{ban_id}/revoke": {"post": {"tags": ["admin"], "summary": "Revoke Ban", "description": "End an active ban now. 404 if there is no active ban with that id.", "operationId": "revoke_ban", "security": [{"HTTPBearer": []}], "parameters": [{"name": "ban_id", "in": "path", "required": true, "schema": {"type": "integer", "maximum": 9223372036854775807, "minimum": 1, "title": "Ban Id"}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Revocation"}}}}, "responses": {"204": {"description": "Successful Response"}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/admin/audit": {"get": {"tags": ["admin"], "summary": "List Audit Log", "description": "The latest admin actions, newest first.", "operationId": "list_audit_log", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"items": {"$ref": "#/components/schemas/AuditEntry"}, "type": "array", "title": "Response List Audit Log"}}}}}, "security": [{"HTTPBearer": []}]}}, "/admin/rules": {"get": {"tags": ["admin"], "summary": "List Rules", "description": "Every rule, in the order they are tried.", "operationId": "list_rules", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"items": {"$ref": "#/components/schemas/RuleRecord"}, "type": "array", "title": "Response List Rules"}}}}}, "security": [{"HTTPBearer": []}]}, "post": {"tags": ["admin"], "summary": "Create Rule", "description": "A new rule, tried after every existing one.", "operationId": "create_rule", "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/RuleForm"}}}, "required": true}, "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/NewRule"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}, "security": [{"HTTPBearer": []}]}}, "/admin/rules/markers": {"get": {"tags": ["admin"], "summary": "List Rule Markers", "description": "What a rule's templates can use.", "operationId": "list_rule_markers", "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"items": {"$ref": "#/components/schemas/Marker"}, "type": "array", "title": "Response List Rule Markers"}}}}}, "security": [{"HTTPBearer": []}]}}, "/admin/rules/preview": {"post": {"tags": ["admin"], "summary": "Preview Rule", "description": "What a rule (saved or not) would answer a request from an address, using everything the\nhoneypot knows about that address. Issues no canary and records nothing.", "operationId": "preview_rule", "requestBody": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/PreviewRequest"}}}, "required": true}, "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Preview"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}, "security": [{"HTTPBearer": []}]}}, "/admin/rules/{rule_id}": {"get": {"tags": ["admin"], "summary": "Get Rule", "operationId": "get_rule", "security": [{"HTTPBearer": []}], "parameters": [{"name": "rule_id", "in": "path", "required": true, "schema": {"type": "integer", "maximum": 9223372036854775807, "minimum": 1, "title": "Rule Id"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RuleRecord"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}, "post": {"tags": ["admin"], "summary": "Update Rule", "operationId": "update_rule", "security": [{"HTTPBearer": []}], "parameters": [{"name": "rule_id", "in": "path", "required": true, "schema": {"type": "integer", "maximum": 9223372036854775807, "minimum": 1, "title": "Rule Id"}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RuleForm"}}}}, "responses": {"204": {"description": "Successful Response"}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/admin/rules/{rule_id}/move": {"post": {"tags": ["admin"], "summary": "Move Rule", "description": "Swap a rule with the one before (up) or after it (down): earlier rules are tried first.", "operationId": "move_rule", "security": [{"HTTPBearer": []}], "parameters": [{"name": "rule_id", "in": "path", "required": true, "schema": {"type": "integer", "maximum": 9223372036854775807, "minimum": 1, "title": "Rule Id"}}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Move"}}}}, "responses": {"204": {"description": "Successful Response"}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/admin/rules/{rule_id}/remove": {"post": {"tags": ["admin"], "summary": "Remove Rule", "description": "Stop using a rule. It is kept, so the hits it answered still name it.", "operationId": "remove_rule", "security": [{"HTTPBearer": []}], "parameters": [{"name": "rule_id", "in": "path", "required": true, "schema": {"type": "integer", "maximum": 9223372036854775807, "minimum": 1, "title": "Rule Id"}}], "responses": {"204": {"description": "Successful Response"}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}}, "components": {"schemas": {"AddressActivity": {"properties": {"ip_address": {"type": "string", "title": "Ip Address"}, "country_code": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Country Code"}, "requests": {"type": "integer", "title": "Requests"}, "distinct_paths": {"type": "integer", "title": "Distinct Paths"}, "login_attempts": {"type": "integer", "title": "Login Attempts"}, "first_seen_at": {"anyOf": [{"type": "string", "format": "date-time"}, {"type": "null"}], "title": "First Seen At"}, "last_seen_at": {"anyOf": [{"type": "string", "format": "date-time"}, {"type": "null"}], "title": "Last Seen At"}}, "type": "object", "required": ["ip_address", "country_code", "requests", "distinct_paths", "login_attempts", "first_seen_at", "last_seen_at"], "title": "AddressActivity"}, "AuditAction": {"type": "string", "enum": ["login", "ban_created", "ban_revoked", "rule_created", "rule_changed", "rule_removed"], "title": "AuditAction"}, "AuditEntry": {"properties": {"id": {"type": "integer", "title": "Id"}, "logged_at": {"type": "string", "format": "date-time", "title": "Logged At"}, "email": {"type": "string", "title": "Email"}, "action": {"$ref": "#/components/schemas/AuditAction"}, "target_ip": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Target Ip"}, "details": {"type": "string", "title": "Details"}}, "type": "object", "required": ["id", "logged_at", "email", "action", "target_ip", "details"], "title": "AuditEntry"}, "Ban": {"properties": {"since": {"type": "string", "format": "date-time", "title": "Since"}, "until": {"anyOf": [{"type": "string", "format": "date-time"}, {"type": "null"}], "title": "Until"}}, "type": "object", "required": ["since", "until"], "title": "Ban", "description": "An address's active ban, as the public sees it: when, never why or by whom."}, "BanRecord": {"properties": {"id": {"type": "integer", "title": "Id"}, "ip_address": {"type": "string", "title": "Ip Address"}, "added": {"type": "string", "format": "date-time", "title": "Added"}, "expires": {"anyOf": [{"type": "string", "format": "date-time"}, {"type": "null"}], "title": "Expires"}, "reason": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Reason"}, "added_by": {"type": "string", "title": "Added By"}, "revoked_at": {"anyOf": [{"type": "string", "format": "date-time"}, {"type": "null"}], "title": "Revoked At"}, "revoked_by": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Revoked By"}, "revocation_reason": {"anyOf": [{"type": "string"}, {"type": "null"}], "title": "Revocation Reason"}, "active": {"type": "boolean", "title": "Active"}}, "type": "object", "required": ["id", "ip_address", "added", "expires", "reason", "added_by", "revoked_at", "revoked_by", "revocation_reason", "active"], "title": "BanRecord", "description": "A ban in full: who made it and why, and whether and why it was revoked."}, "Canary": {"properties": {"secret": {"type": "string", "title": "Secret"}}, "type": "object", "required": ["secret"], "title": "Canary", "description": "The secret to put in it: fresh, random, and recorded against the visitor."}, "CanaryOrigin": {"properties": {"path": {"type": "string", "title": "Path"}, "ip_address": {"type": "string", "title": "Ip Address"}, "issued_at": {"type": "string", "format": "date-time", "title": "Issued At"}}, "type": "object", "required": ["path", "ip_address", "issued_at"], "title": "CanaryOrigin", "description": "Where a canary password was handed out: the leaked file, to whom, and when."}, "CanaryRequest": {"properties": {"path": {"type": "string", "maxLength": 16384, "title": "Path"}}, "type": "object", "required": ["path"], "title": "CanaryRequest", "description": "A leaked 