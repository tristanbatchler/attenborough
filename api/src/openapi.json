{"openapi": "3.1.0", "info": {"title": "FastAPI", "version": "0.1.0"}, "paths": {"/exhibit/feed": {"get": {"tags": ["exhibit"], "summary": "List Recent Activity", "description": "The latest visitor activity from every IP address, newest first.", "operationId": "list_recent_activity", "parameters": [{"name": "page", "in": "query", "required": false, "schema": {"type": "integer", "maximum": 10737419, "minimum": 1, "default": 1, "title": "Page"}}, {"name": "take", "in": "query", "required": false, "schema": {"type": "integer", "maximum": 200, "minimum": 1, "default": 20, "title": "Take"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Page_ListRecentActivityRow_"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/exhibit/ip/{ip_addr}/activity": {"get": {"tags": ["exhibit"], "summary": "Get Ip Activity", "description": "Everything one IP address did, newest first.", "operationId": "get_ip_activity", "parameters": [{"name": "ip_addr", "in": "path", "required": true, "schema": {"type": "string", "format": "ipvanyaddress", "title": "Ip Addr"}}, {"name": "page", "in": "query", "required": false, "schema": {"type": "integer", "maximum": 10737419, "minimum": 1, "default": 1, "title": "Page"}}, {"name": "take", "in": "query", "required": false, "schema": {"type": "integer", "maximum": 200, "minimum": 1, "default": 20, "title": "Take"}}], "responses": {"200": {"description": "Successful Response", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Page_ListIpActivityRow_"}}}}, "422": {"description": "Validation Error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HTTPValidationError"}}}}}}}, "/ingest/hits": {"post": {"tags": ["ingest"], "summary": "Report Hit", "description": "Record a request the decoy app served, as a honeypot hit.\n\nWr